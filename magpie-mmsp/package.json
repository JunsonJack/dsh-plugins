{
  "name": "magpie-mmsp",
  "version": "0.1.6",
  "description": "MMSP protocol conversion provider for magpie: speaks chat completions to the gateway and MMSP to go.penguin.ooo",
  "type": "module",
  "main": "./index.mjs",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "auth",
    "plugin",
    "provider",
    "magpie",
    "mmsp"
  ],
  "license": "MIT",
  "files": [
    "index.mjs",
    "lib",
    "panel",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/"
  },
  "magpie": {
    "name": "MMSP v0.1.6",
    "icon": "data:image/svg+xml;base64,",
    "options": {
      "baseURL": "https://go.penguin.ooo",
      "headers": ""
    },
    "panels": [
      {
        "slot": "settings",
        "file": "panel/headers.html",
        "title": "MMSP 设置"
      }
    ]
  }
}
