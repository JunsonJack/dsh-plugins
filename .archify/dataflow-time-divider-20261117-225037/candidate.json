  "cards": [
    {
      "dot": "emerald",
      "title": "单一真相源",
      "items": [
        "chatFlow / flowKey / clock 三个结构选择器取自 host-probe.ts 导出的 HOST_SELECTORS",
        "qq-time-divider.ts 起手 import HOST_SELECTORS，规则与探针不会走散",
        "data-chat-turn 以本文件常量 TURN_ATTRIBUTE 读取，同一回合多行共享该值"
      ]
    },
    {
      "dot": "violet",
      "title": "抽取与三级匹配",
      "items": [
        "宿主把「用量 xx tok」与时钟同放一个 data-clock，chip 实测形如「用量 72.3K tok19:57」，故用 extractClock 在任意位置抽取",
        "CLOCK_PATTERNS 按信息量从多到少：跨年 YYYY年M月D日 HH:mm → 今年内 M月D日 HH:mm → 当天 HH:mm",
        "逐个 matchAll 候选，尾巴紧跟 : 或数字的作废，避免把 12:30:45 的秒当分钟"
      ]
    },
    {
      "dot": "amber",
      "title": "分组与幂等注入",
      "items": [
        "leafRows 排除 ChatGroupSeat 等容器，只保留叶子流 item",
        "groupByTurn 连续同 data-chat-turn 归一组；planDividers 仅在 dayKey 变化时安排分隔条",
        "alignDividers 对比现有条的数量/文本/位置，完全一致时零变更，避免 observer 自循环"
      ]
    }
  ]
}
