{
  "name": "dsh-llm-mmsp",
  "version": "0.4.0",
  "description": "MMSP protocol adapter for DeepSeek Harness: talk to go.penguin.ooo (and other MMSP servers) directly. Settings page for the upstream with all six MMSP thinking levels and thinking summaries, a drag-sortable multi-key pool with round-robin/priority rotation, automatic failover and live per-key usage counters.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./protocol": "./lib/mmsp-protocol.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mmsp-adapter.js",
    "lib/mmsp-protocol.js",
    "lib/key-pool.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mmsp",
    "penguin",
    "llm",
    "protocol-adapter"
  ],
  "license": "MIT"
}

